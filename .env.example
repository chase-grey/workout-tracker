# Copy to .env and fill in. The deploy:backend script writes VITE_API_URL for you.
VITE_API_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# --- Chat assistant (used only by the local `npm run dev` proxy) ---
# These power the /api/chat dev proxy in vite.config.ts. The key stays in this
# gitignored file and is never shipped to the browser bundle.
#
# Epic (Noggin) key — works only when running locally on Epic's network:
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://llmproxy.epic.com/v1"
OPENAI_MODEL="gpt-4o"
# TLS verification is skipped automatically for *.epic.com hosts (Noggin's cert
# isn't in the public trust store). Set "false" to force verification, "true" to force skip.
# OPENAI_INSECURE_TLS="true"
#
# To use a standard OpenAI key instead, set:
#   OPENAI_BASE_URL="https://api.openai.com/v1"  and OPENAI_MODEL="gpt-4o-mini"

# --- Phone access (npm run dev:phone) ---
# The address Settings shows as a QR, which a phone on the same wifi loads to get
# the coach. Left unset it's worked out from this machine's network adapters; set
# it to pin the answer when that guesses the wrong adapter.
# SHARE_URL="http://192.168.1.42:5173"

# --- Auto-fixer (npm run autofix, or npm run dev:phone) ---
# A GitHub fine-grained PAT for this repo. It powers two things:
#   1. The local auto-fixer here — needs Issues: R/W (to claim/close issues) and
#      Contents: R/W (to push the fix to main).
#   2. Separately, the SAME token value goes in the Apps Script GITHUB_ISSUE_TOKEN
#      script property so the deployed app can file issues (Issues: R/W is enough
#      there). Create it at github.com/settings/tokens?type=beta scoped to only
#      chase-grey/workout-tracker.
# Unset, `npm run autofix` refuses to run.
GITHUB_ISSUE_TOKEN=""
# Poll cadence and the label that marks an issue as fair game for the fixer.
# AUTOFIX_LABEL="auto-fix"
# AUTOFIX_INTERVAL_SEC="60"
# How much the local `claude` is allowed to do unattended. "acceptEdits" lets it
# edit files and run commands you've allowed; "skip" passes
# --dangerously-skip-permissions for fully hands-off runs (riskier).
# AUTOFIX_PERMISSION="acceptEdits"
